# Copia este archivo a .env y rellena los valores. .env NO se versiona.
# Ver docs/secretos.md

# Contraseña del usuario de MySQL que usa la aplicación
DB_PASSWORD=

# Cuenta de correo del consultorio y su contraseña de aplicación de Gmail
MAIL_USERNAME=
MAIL_PASSWORD=

# Clave de firma de los JWT (mínimo 32 bytes; `openssl rand -base64 48`)
JWT_SECRET=
